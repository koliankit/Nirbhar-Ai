# ═══════════════════════════════════════════════════
# NIRBHAR AI — Environment Configuration
# ═══════════════════════════════════════════════════

# App Identity
APP_NAME=Nirbhar AI
APP_TAGLINE=Enterprise Intelligence Powered by AI
APP_VERSION=1.0.0
APP_URL=https://nirbhar.ai
APP_SUPPORT_EMAIL=support@nirbhar.ai
APP_SALES_EMAIL=sales@nirbhar.ai

# Branding
BRAND_NAME=Nirbhar AI
BRAND_SHORT=NirbharAI
BRAND_PRIMARY_COLOR=#00E5FF
BRAND_ACCENT_COLOR=#0066FF
BRAND_BG_DARK=#030810
BRAND_BG_LIGHT=#F8FBFF

# API Config (replace with real values)
API_BASE_URL=https://api.nirbhar.ai/v1
API_VERSION=v1
API_TIMEOUT=30000

# Feature Flags
FEATURE_DARK_MODE=true
FEATURE_PARTICLE_BG=true
FEATURE_ANIMATIONS=true
FEATURE_TYPEWRITER=true

# Analytics (replace with real IDs)
# GA_TRACKING_ID=G-XXXXXXXXXX
# MIXPANEL_TOKEN=your_token_here

# Environment
NODE_ENV=production
